PORT=5000
NODE_ENV=development
# Set this to your frontend URL when needed, for example http://localhost:5173
CORS_ORIGIN=*
# Firebase project ID from Firebase Console > Project settings > General
FIREBASE_PROJECT_ID=resolve-multi-store-fulfilment
# Set to true after configuring server-side Firebase credentials
FIRESTORE_PERSISTENCE=false
# Absolute path to a service-account JSON file; keep that file private and out of git
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
# Local demo admin login. Change these before exposing the app beyond localhost.
DEMO_ADMIN_ID=admin
DEMO_ADMIN_PASSWORD=admin123
